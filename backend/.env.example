# ==============================================================================
# Mon IUT - Configuration des variables d'environnement Backend
# ==============================================================================

# Port d'écoute du serveur (Render injecte automatiquement la variable PORT)
PORT=5000

# Environnement d'exécution : 'development' ou 'production'
NODE_ENV=development

# ==============================================================================
# Base de données (MySQL / MariaDB en développement XAMPP, TiDB Cloud en production)
# ==============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mon-iut

# Pour TiDB Cloud en production, activer le chiffrement SSL obligatoire :
# DB_SSL=true
# DB_SSL_CA=/chemin/vers/ca-cert.pem (optionnel, certificat système utilisé par défaut)

# URL de connexion complète alternative (optionnelle, prioritaire si définie)
# DATABASE_URL=mysql://user:password@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/mon_iut?ssl={"rejectUnauthorized":true}

# ==============================================================================
# Sécurité & Authentification JWT
# ==============================================================================
# Clés secrètes pour signer les tokens (A remplacer impérativement en production)
JWT_SECRET=super_secret_jwt_access_key_change_me_in_production_12345
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_me_in_production_67890

# Durées de validité des tokens
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Nombre de rounds pour le hachage des mots de passe avec bcrypt
BCRYPT_ROUNDS=10

# ==============================================================================
# Configuration CORS (Origines autorisées, séparées par des virgules)
# ==============================================================================
# En dev: localhost. En prod: domaine Vercel frontend et domaine Render API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://mon-iut-web.vercel.app

# ==============================================================================
# Limitation de débit (Rate Limiting)
# ==============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=15

# ==============================================================================
# Uploads de fichiers
# ==============================================================================
UPLOAD_DIR=uploads/documents
MAX_FILE_SIZE_MB=15
