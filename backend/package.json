{
  "name": "mon-iut-backend",
  "version": "2.0.0",
  "description": "API REST unifiée Express.js pour la plateforme Mon IUT (Web Admin/Enseignant/Responsable et Application Mobile)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node scripts/init-db.js",
    "test": "jest --detectOpenHandles --forceExit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json}\""
  },
  "keywords": [
    "express",
    "mon-iut",
    "jwt",
    "mysql",
    "tidb",
    "rest-api"
  ],
  "author": "Yokomi-YBJ",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
